@@ -1520,4 +1520,84 @@ mod thread_processor_behavior_tests {
         );
         Ok(())
     }
+
+    #[tokio::test]
+    async fn mcp_retirement_subscriber_count_transitions_are_exact() -> Result<()> {
+        let manager = ThreadStateManager::new();
+        let thread_id = ThreadId::from_string("c431c733-af0e-425b-aed0-0ca9fa08d01f")?;
+        let connection_a = ConnectionId(1);
+        let connection_b = ConnectionId(2);
+        manager
+            .connection_initialized(connection_a, ConnectionCapabilities::default())
+            .await;
+        manager
+            .connection_initialized(connection_b, ConnectionCapabilities::default())
+            .await;
+
+        let (_, initial_count, initial_seq) = manager
+            .try_ensure_connection_subscribed_with_count(
+                thread_id,
+                connection_a,
+                /*experimental_raw_events*/ false,
+            )
+            .await
+            .expect("first live connection should subscribe");
+        assert_eq!(initial_count, 1);
+        let (_, duplicate_count, duplicate_seq) = manager
+            .try_ensure_connection_subscribed_with_count(
+                thread_id,
+                connection_a,
+                /*experimental_raw_events*/ false,
+            )
+            .await
+            .expect("duplicate live connection should remain subscribed");
+        assert_eq!(duplicate_count, 1);
+        let (second_count, second_seq) = manager
+            .try_add_connection_to_thread_with_count(thread_id, connection_b)
+            .await
+            .expect("second live connection should subscribe");
+        assert_eq!(second_count, 2);
+
+        let non_final = manager
+            .unsubscribe_connection_from_thread_with_count(thread_id, connection_a)
+            .await;
+        assert!(non_final.changed);
+        assert_eq!(non_final.subscriber_count, 1);
+        let final_unsubscribe = manager
+            .unsubscribe_connection_from_thread_with_count(thread_id, connection_b)
+            .await;
+        assert!(final_unsubscribe.changed);
+        assert_eq!(final_unsubscribe.subscriber_count, 0);
+
+        let (resubscribe_count, resubscribe_seq) = manager
+            .try_add_connection_to_thread_with_count(thread_id, connection_b)
+            .await
+            .expect("resubscribe must publish the exact positive count that cancels retirement");
+        assert_eq!(resubscribe_count, 1);
+        let removed = manager.remove_connection_with_counts(connection_b).await;
+        assert_eq!(removed.len(), 1);
+        let (removed_thread_id, removed_count, removed_seq) = removed[0];
+        assert_eq!(
+            (removed_thread_id, removed_count),
+            (thread_id, 0),
+            "connection close must nominate retirement only after the exact final count"
+        );
+
+        // Every publication carries a strictly increasing mutation sequence so
+        // stale publications can never clobber newer counts.
+        let seqs = [
+            initial_seq,
+            duplicate_seq,
+            second_seq,
+            non_final.seq,
+            final_unsubscribe.seq,
+            resubscribe_seq,
+            removed_seq,
+        ];
+        assert!(
+            seqs.windows(2).all(|pair| pair[0] < pair[1]),
+            "mutation sequences must be strictly increasing in mutation order: {seqs:?}"
+        );
+        Ok(())
+    }
 }
