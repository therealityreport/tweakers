+    }
+
+    /// Publishes the exact post-subscription count and cancels any stale retirement
+    /// timer. `seq` is the mutation sequence assigned under the ThreadStateManager
+    /// lock; stale sequences are rejected.
+    pub fn note_mcp_subscriber_count(&self, subscriber_count: usize, seq: u64) {
+        self.session
+            .note_app_server_mcp_subscribers(subscriber_count, seq);
+    }
+
