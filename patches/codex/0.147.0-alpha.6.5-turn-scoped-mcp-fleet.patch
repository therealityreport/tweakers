@@ -0,0 +1,119 @@
+//! Turn-scoped MCP fleets for subagent threads.
+//!
+//! Subagent threads stay loaded and subscribed for the lifetime of their
+//! parent, so their MCP servers would otherwise remain resident long after the
+//! last turn finished. Once a turn has been idle for the delay below, the
+//! thread's servers are shut down and the runtime is marked dirty; the next
+//! tool call or turn start respawns them through `refresh_mcp_if_dirty`.
+//!
+//! The scheduled teardown retries instead of firing once: a thread that is busy
+//! when its deadline lands would otherwise keep its fleet until the parent
+//! exits, because the paths that disarm the timer (turn start, interrupt,
+//! guardian abort) vastly outnumber the ones that arm it.
+
+use std::time::Duration;
+
+use super::*;
+
+/// How long a subagent thread's turn must stay idle before its MCP servers
+/// are shut down.
+pub(crate) const MCP_TURN_IDLE_SHUTDOWN_DELAY: Duration = Duration::from_secs(60);
+
+/// Counter incremented once per reclaimed subagent MCP fleet.
+const MCP_TURN_IDLE_SHUTDOWN_METRIC: &str = "codex.mcp.turn_idle_shutdown";
+/// Counter incremented when an idle deadline lands on a thread that is still busy.
+const MCP_TURN_IDLE_SHUTDOWN_SKIPPED_METRIC: &str = "codex.mcp.turn_idle_shutdown.skipped";
+
+impl Session {
+    pub(super) async fn is_non_root_agent_thread(&self) -> bool {
+        let state = self.state.lock().await;
+        state
+            .session_configuration
+            .session_source
+            .is_non_root_agent()
+    }
+
+    pub(crate) fn abort_idle_mcp_shutdown(&self) {
+        let handle = self
+            .mcp_idle_shutdown
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take();
+        if let Some(handle) = handle {
+            handle.abort();
+        }
+    }
+
+    pub(crate) async fn schedule_idle_mcp_shutdown(self: &Arc<Self>, delay: Duration) {
+        if !self.is_non_root_agent_thread().await {
+            return;
+        }
+        let session = Arc::downgrade(self);
+        let handle = self
+            .services
+            .runtime_handle
+            .spawn(async move {
+                loop {
+                    tokio::time::sleep(delay).await;
+                    // Only hold the session across the check, never across the sleep.
+                    let Some(session) = session.upgrade() else {
+                        return;
+                    };
+                    if session.shutdown_mcp_if_turn_idle().await {
+                        return;
+                    }
+                }
+            })
+            .abort_handle();
+        let previous = self
+            .mcp_idle_shutdown
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .replace(handle);
+        if let Some(previous) = previous {
+            previous.abort();
+        }
+    }
+
+    pub(crate) async fn shutdown_mcp_if_turn_idle(self: &Arc<Self>) -> bool {
+        // New work may have raced with the idle delay; keep a busy thread's fleet.
+        let busy_reason = if self.active_turn.lock().await.is_some() {
+            Some("active_turn")
+        } else if self.input_queue.has_trigger_turn_mailbox_items().await {
+            Some("mailbox")
+        } else {
+            None
+        };
+        if let Some(reason) = busy_reason {
+            self.services.session_telemetry.counter(
+                MCP_TURN_IDLE_SHUTDOWN_SKIPPED_METRIC,
+                /*inc*/ 1,
+                &[("reason", reason)],
+            );
+            // The caller retries every delay, so a long turn would emit one line per
+            // minute at info level; the counter carries the signal for aggregates.
+            debug!(
+                thread_id = %self.thread_id,
+                reason,
+                "keeping subagent MCP servers; thread is not idle"
+            );
+            return false;
+        }
+        let configured_servers = self
+            .services
+            .mcp_runtime
+            .current_config()
+            .map_or(0, |config| codex_mcp::configured_mcp_servers(&config).len());
+        self.services.mcp_runtime.shutdown().await;
+        self.mark_mcp_runtime_dirty();
+        self.services
+            .session_telemetry
+            .counter(MCP_TURN_IDLE_SHUTDOWN_METRIC, /*inc*/ 1, &[]);
+        info!(
+            thread_id = %self.thread_id,
+            configured_servers,
+            "shut down idle subagent MCP servers"
+        );
+        true
+    }
+}
