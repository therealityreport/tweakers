diff --git a/codex-rs/core/src/session/mcp_idle.rs b/codex-rs/core/src/session/mcp_idle.rs
new file mode 100644
index 0000000..2f9516d
--- /dev/null
+++ b/codex-rs/core/src/session/mcp_idle.rs
@@ -0,0 +1,74 @@
+//! Turn-scoped MCP fleets for subagent threads.
+//!
+//! Subagent threads stay loaded and subscribed for the lifetime of their
+//! parent, so their MCP servers would otherwise remain resident long after the
+//! last turn finished. Once a turn has been idle for the delay below, the
+//! thread's servers are shut down and the runtime is marked dirty; the next
+//! tool call or turn start respawns them through `refresh_mcp_if_dirty`.
+
+use std::time::Duration;
+
+use super::*;
+
+/// How long a subagent thread's turn must stay idle before its MCP servers
+/// are shut down.
+pub(crate) const MCP_TURN_IDLE_SHUTDOWN_DELAY: Duration = Duration::from_secs(60);
+
+impl Session {
+    pub(crate) fn abort_idle_mcp_shutdown(&self) {
+        let handle = self
+            .mcp_idle_shutdown
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take();
+        if let Some(handle) = handle {
+            handle.abort();
+        }
+    }
+
+    pub(crate) async fn schedule_idle_mcp_shutdown(self: &Arc<Self>, delay: Duration) {
+        let is_non_root_agent = {
+            let state = self.state.lock().await;
+            state
+                .session_configuration
+                .session_source
+                .is_non_root_agent()
+        };
+        if !is_non_root_agent {
+            return;
+        }
+        let session = Arc::downgrade(self);
+        let handle = self
+            .services
+            .runtime_handle
+            .spawn(async move {
+                tokio::time::sleep(delay).await;
+                let Some(session) = session.upgrade() else {
+                    return;
+                };
+                session.shutdown_mcp_if_turn_idle().await;
+            })
+            .abort_handle();
+        let previous = self
+            .mcp_idle_shutdown
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .replace(handle);
+        if let Some(previous) = previous {
+            previous.abort();
+        }
+    }
+
+    pub(crate) async fn shutdown_mcp_if_turn_idle(self: &Arc<Self>) -> bool {
+        // New work may have raced with the idle delay; keep a busy thread's fleet.
+        if self.active_turn.lock().await.is_some()
+            || self.input_queue.has_trigger_turn_mailbox_items().await
+        {
+            return false;
+        }
+        self.services.mcp_runtime.shutdown().await;
+        self.mark_mcp_runtime_dirty();
+        debug!(thread_id = %self.thread_id, "shut down idle subagent MCP servers");
+        true
+    }
+}
