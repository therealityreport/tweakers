+    let mut config = reusable_server_config("http://127.0.0.1:1");
+    config.transport = McpServerTransportConfig::Stdio {
+        command: "codex-test-deferred-server".to_string(),
+        args: Vec::new(),
+        env: None,
+        env_vars: Vec::new(),
+        cwd: None,
+    };
+    config
+}
+
+fn deferred_reconcile_input(
+    codex_home: PathBuf,
+    runtime_context: McpRuntimeContext,
+    tx_event: Option<async_channel::Sender<Event>>,
+    mcp_servers: HashMap<String, EffectiveMcpServer>,
+) -> McpRuntimeInput {
+    McpRuntimeInput {
+        config: Arc::new(crate::mcp::tests::test_mcp_config(codex_home)),
+        plugins_available: false,
+        ready_selected_capability_roots: Vec::new(),
+        mcp_servers,
+        submit_id: "deferred".to_string(),
+        tx_event,
+        startup_cancellation_token: CancellationToken::new(),
+        runtime_context,
+        codex_apps_tools_cache: ConnectorRuntimeManager::default(),
+        tool_catalog_cache: McpToolCatalogCache::default(),
+        codex_apps_tools_cache_key: ConnectorRuntimeContextKey::personal(
+            /*account_id*/ None,
+            /*chatgpt_user_id*/ None,
+        ),
+        supports_openai_form_elicitation: false,
+        auth: None,
+        codex_apps_auth_manager: None,
+        elicitation_reviewer: None,
+        elicitation_lifecycle: None,
+        deferred_startup: true,
+    }
+}
+
+async fn deferred_stdio_manager(
+    tx_event: Option<async_channel::Sender<Event>>,
+    codex_home: PathBuf,
+) -> Arc<McpConnectionSet> {
+    let runtime_context = reusable_server_runtime_context();
+    Arc::new(
+        McpConnectionSet::new(
+            /*previous*/ None,
+            McpPublicationGate::already_published(),
+            deferred_reconcile_input(
+                codex_home,
+                runtime_context,
+                tx_event,
+                HashMap::from([
+                    (
+                        "alpha".to_string(),
+                        EffectiveMcpServer::configured(deferred_stdio_server_config()),
+                    ),
+                    (
+                        "beta".to_string(),
+                        EffectiveMcpServer::configured(deferred_stdio_server_config()),
+                    ),
+                ]),
+            ),
+            ElicitationRequestRouter::default(),
+        )
+        .await,
+    )
+}
+
+fn assert_startup_untouched(manager: &McpConnectionSet, server: &str, context: &str) {
+    assert!(
+        !manager
+            .test_client(server)
+            .startup_begun
+            .load(Ordering::Acquire),
+        "{context}: `{server}` startup future must stay un-polled"
+    );
+    assert!(
+        !manager
+            .test_client(server)
+            .startup_complete
+            .load(Ordering::Acquire),
+        "{context}: `{server}` startup must not run"
+    );
+}
+
+#[tokio::test]
+async fn deferred_reconcile_does_not_initiate_any_server_startup() {
+    let (tx_event, rx_event) = async_channel::unbounded();
+    let codex_home = tempdir().expect("tempdir");
+    let manager = deferred_stdio_manager(Some(tx_event), codex_home.path().to_path_buf()).await;
+
+    // The eager reconcile would have spawned startup drivers that immediately
+    // poll each server's shared startup future and emit per-server
+    // McpStartupUpdate events. Deferred reconcile must leave every stdio
+    // startup future un-polled and emit no per-server startup status.
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    for server in ["alpha", "beta"] {
+        assert_startup_untouched(&manager, server, "deferred reconcile");
+    }
+    while let Ok(event) = rx_event.try_recv() {
+        assert!(
+            !matches!(event.msg, EventMsg::McpStartupUpdate(_)),
+            "deferred reconcile must not emit per-server startup events, got {event:?}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn deferred_demand_starts_exactly_the_demanded_server() {
+    let codex_home = tempdir().expect("tempdir");
+    let manager = deferred_stdio_manager(/*tx_event*/ None, codex_home.path().to_path_buf()).await;
+    for server in ["alpha", "beta"] {
+        assert_startup_untouched(&manager, server, "deferred reconcile");
+    }
+
+    // Demanding one server polls exactly that server's shared startup future,
+    // driving its startup to completion (here: a fast failure because the test
+    // environment provides no local stdio runtime). The sibling stays
+    // un-polled.
+    let _server_ready = tokio::time::timeout(
+        Duration::from_secs(60),
+        manager.wait_for_server_startup("alpha"),
+    )
+    .await
+    .expect("demand-poll must drive the deferred startup to completion");
+    assert!(
+        manager
+            .test_client("alpha")
+            .startup_begun
+            .load(Ordering::Acquire),
+        "demand path must poll the demanded deferred server"
+    );
+    assert!(
+        manager
+            .test_client("alpha")
+            .startup_complete
+            .load(Ordering::Acquire),
+        "demand path must drive the demanded deferred server to a startup outcome"
+    );
+    assert_startup_untouched(&manager, "beta", "demand for alpha");
+}
+
+#[tokio::test]
+async fn deferred_binding_capture_ignites_cold_catalog_stdio_servers() {
+    let codex_home = tempdir().expect("tempdir");
+    let manager = deferred_stdio_manager(/*tx_event*/ None, codex_home.path().to_path_buf()).await;
+    for server in ["alpha", "beta"] {
+        assert_startup_untouched(&manager, server, "deferred reconcile");
+    }
+
+    // With a cold tool-catalog cache, binding construction is the demand that
+    // ignites deferred stdio servers so their tools are captured rather than
+    // silently dropped.
+    let _binding = tokio::time::timeout(Duration::from_secs(60), capture_binding(&manager))
+        .await
+        .expect("binding capture must complete");
+    for server in ["alpha", "beta"] {
+        assert!(
+            manager
+                .test_client(server)
+                .startup_complete
+                .load(Ordering::Acquire),
+            "binding capture must drive cold-catalog deferred `{server}` to a startup outcome"
+        );
+    }
+}
+
+#[tokio::test]
+async fn deferred_set_keeps_http_servers_eager() {
+    let runtime_context = reusable_server_runtime_context();
+    let codex_home = tempdir().expect("tempdir");
+    let manager = Arc::new(
+        McpConnectionSet::new(
+            /*previous*/ None,
+            McpPublicationGate::already_published(),
+            deferred_reconcile_input(
+                codex_home.path().to_path_buf(),
+                runtime_context,
+                /*tx_event*/ None,
+                HashMap::from([
+                    (
+                        "alpha".to_string(),
+                        EffectiveMcpServer::configured(deferred_stdio_server_config()),
+                    ),
+                    (
+                        "web".to_string(),
+                        EffectiveMcpServer::configured(reusable_server_config(
+                            "http://127.0.0.1:1",
+                        )),
+                    ),
+                ]),
+            ),
+            ElicitationRequestRouter::default(),
+        )
+        .await,
+    );
+
+    // HTTP servers spawn no local process and have no cacheable tool catalog:
+    // they keep their eager startup driver even in deferred sets.
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(60);
+    while !manager
+        .test_client("web")
+        .startup_complete
+        .load(Ordering::Acquire)
+    {
+        assert!(
+            tokio::time::Instant::now() < deadline,
+            "eager HTTP startup driver must run in a deferred set"
+        );
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    assert_startup_untouched(&manager, "alpha", "eager HTTP sibling startup");
+}
+
+#[tokio::test]
+async fn deferred_shutdown_does_not_ignite_never_started_servers() {
+    let codex_home = tempdir().expect("tempdir");
+    let manager = deferred_stdio_manager(/*tx_event*/ None, codex_home.path().to_path_buf()).await;
+    for server in ["alpha", "beta"] {
+        assert_startup_untouched(&manager, server, "deferred reconcile");
+    }
+
+    // Teardown must never first-poll a never-demanded startup future: doing so
+    // could transiently spawn the stdio server exactly when the fleet is
+    // supposed to quiesce.
+    tokio::time::timeout(Duration::from_secs(10), manager.shutdown())
+        .await
+        .expect("deferred shutdown must complete without polling startups");
+    for server in ["alpha", "beta"] {
+        assert_startup_untouched(&manager, server, "deferred shutdown");
+        assert!(
+            manager.test_client(server).cancel_token.is_cancelled(),
+            "deferred shutdown must cancel `{server}`'s startup token"
+        );
+    }
+}
