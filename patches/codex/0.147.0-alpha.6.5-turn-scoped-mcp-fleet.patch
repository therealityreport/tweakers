+async fn mark_session_as_subagent(session: &Session) {
+    let mut state = session.state.lock().await;
+    state.session_configuration.session_source =
+        SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id: ThreadId::new(),
+            depth: 1,
+            agent_path: None,
+            agent_nickname: None,
+            agent_role: None,
+        });
+}
+
+fn idle_mcp_shutdown_is_armed(session: &Session) -> bool {
+    session
+        .mcp_idle_shutdown
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .is_some()
+}
+
+/// Yields enough times to let every ready task on the current-thread runtime make
+/// progress. Yielding rather than sleeping keeps the scheduler busy, so the paused
+/// clock cannot auto-advance into a later deadline while draining.
+async fn drain_paused_runtime() {
+    for _ in 0..64 {
+        tokio::task::yield_now().await;
+    }
+}
+
+/// Fires exactly one `MCP_TURN_IDLE_SHUTDOWN_DELAY` deadline on the paused clock and
+/// reports whether `settled` observed the teardown.
+async fn advance_past_idle_mcp_deadline(settled: impl Fn() -> bool) -> bool {
+    // The scheduled task must be polled once so its sleep is registered with the timer
+    // driver; advancing first would move the clock past a deadline that does not exist
+    // yet and silently turn this into a no-op.
+    drain_paused_runtime().await;
+    tokio::time::advance(MCP_TURN_IDLE_SHUTDOWN_DELAY + Duration::from_secs(1)).await;
+    for _ in 0..64 {
+        if settled() {
+            return true;
+        }
+        tokio::task::yield_now().await;
+    }
+    settled()
+}
+
+/// Regression test for a one-shot teardown: a thread that is busy when its deadline
+/// lands must be retried, not abandoned until the parent exits.
+#[tokio::test(start_paused = true)]
+async fn scheduled_idle_mcp_shutdown_retries_until_the_thread_is_idle() {
+    let (session, _turn_context) = make_session_and_context().await;
+    let session = Arc::new(session);
+    mark_session_as_subagent(&session).await;
+    session.refresh_mcp_if_dirty().await;
+    assert!(!session.mcp_refresh.is_pending());
+    *session.active_turn.lock().await = Some(ActiveTurn::default());
+
+    session
+        .schedule_idle_mcp_shutdown(MCP_TURN_IDLE_SHUTDOWN_DELAY)
+        .await;
+
+    assert!(
+        !advance_past_idle_mcp_deadline(|| session.mcp_refresh.is_pending()).await,
+        "a busy thread must keep its MCP fleet"
+    );
+
+    *session.active_turn.lock().await = None;
+    assert!(
+        advance_past_idle_mcp_deadline(|| session.mcp_refresh.is_pending()).await,
+        "the teardown must retry once the thread goes idle"
+    );
+}
+
+/// Interrupts skip `on_task_finished`, so the abort path owns re-arming the teardown.
+#[tokio::test(start_paused = true)]
+async fn interrupted_turn_rearms_idle_mcp_shutdown() {
+    let (session, turn_context) = make_session_and_context().await;
+    let session = Arc::new(session);
+    mark_session_as_subagent(&session).await;
+    session.refresh_mcp_if_dirty().await;
+    assert!(!session.mcp_refresh.is_pending());
+
+    session
+        .spawn_task(
+            Arc::new(turn_context),
+            Vec::new(),
+            NeverEndingTask {
+                kind: TaskKind::Regular,
+                listen_to_cancellation_token: true,
+            },
+        )
+        .await;
+    assert!(
+        !idle_mcp_shutdown_is_armed(&session),
+        "starting a turn disarms the teardown"
+    );
+
+    session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+
+    assert!(
+        advance_past_idle_mcp_deadline(|| session.mcp_refresh.is_pending()).await,
+        "an interrupted turn must still release its MCP fleet"
+    );
+}
+
+/// Drives the prewarm worker through one full loop body. The bounded channel supplies
+/// the happens-after edge: the third send can only land once the worker has taken the
+/// second, which it does only after it finished handling the first.
+async fn settle_mcp_prewarm(prewarm_tx: &async_channel::Sender<()>) {
+    for _ in 0..3 {
+        prewarm_tx.send(()).await.expect("prewarm worker running");
+    }
+}
+
+/// Auth revisions fan out to every live session, so prewarm must not respawn the fleet
+/// that turn-idle teardown just reclaimed.
+#[tokio::test]
+async fn mcp_prewarm_skips_idle_subagent_threads() {
+    let (session, _turn_context) = make_session_and_context().await;
+    let session = Arc::new(session);
+    let (prewarm_tx, prewarm_rx) = async_channel::bounded(1);
+    let (_auth_tx, auth_rx) = tokio::sync::watch::channel(0u64);
+    session.start_mcp_prewarm_worker(prewarm_rx, auth_rx);
+
+    session.mark_mcp_runtime_dirty();
+    settle_mcp_prewarm(&prewarm_tx).await;
+    assert!(
+        !session.mcp_refresh.is_pending(),
+        "root threads still prewarm while idle"
+    );
+
+    mark_session_as_subagent(&session).await;
+    session.mark_mcp_runtime_dirty();
+    settle_mcp_prewarm(&prewarm_tx).await;
+    assert!(
+        session.mcp_refresh.is_pending(),
+        "an idle subagent must leave its runtime dirty for the next turn"
+    );
+
+    *session.active_turn.lock().await = Some(ActiveTurn::default());
+    settle_mcp_prewarm(&prewarm_tx).await;
+    assert!(
+        !session.mcp_refresh.is_pending(),
+        "a subagent with real work still prewarms"
+    );
+
+    session.stop_mcp_prewarm_worker().await;
+}
+
+#[tokio::test]
+async fn idle_turn_shuts_down_mcp_runtime_and_refresh_respawns_it() {
+    let (session, _turn_context) = make_session_and_context().await;
+    let session = Arc::new(session);
+    mark_session_as_subagent(&session).await;
+    session.refresh_mcp_if_dirty().await;
+    let config_before = session
+        .services
+        .mcp_runtime
+        .current_config()
+        .expect("published MCP config");
+    assert!(!session.mcp_refresh.is_pending());
+
+    assert!(session.shutdown_mcp_if_turn_idle().await);
+    assert!(
+        session.mcp_refresh.is_pending(),
+        "idle shutdown must mark the runtime dirty"
+    );
+
+    session.refresh_mcp_if_dirty().await;
+    let config_after = session
+        .services
+        .mcp_runtime
+        .current_config()
+        .expect("republished MCP config");
+    assert!(!session.mcp_refresh.is_pending());
+    assert!(
+        !Arc::ptr_eq(&config_before, &config_after),
+        "refresh after idle shutdown should publish a fresh runtime"
+    );
+}
+
+#[tokio::test]
+async fn idle_mcp_shutdown_keeps_runtime_while_turn_is_active() {
+    let (session, _turn_context) = make_session_and_context().await;
+    let session = Arc::new(session);
+    mark_session_as_subagent(&session).await;
+    session.refresh_mcp_if_dirty().await;
+    *session.active_turn.lock().await = Some(ActiveTurn::default());
+
+    assert!(!session.shutdown_mcp_if_turn_idle().await);
+    assert!(!session.mcp_refresh.is_pending());
+}
+
+#[tokio::test(start_paused = true)]
+async fn idle_mcp_shutdown_is_scheduled_only_for_subagent_threads() {
+    let (session, _turn_context) = make_session_and_context().await;
+    let session = Arc::new(session);
+    session.refresh_mcp_if_dirty().await;
+    assert!(!session.mcp_refresh.is_pending());
+
+    session
+        .schedule_idle_mcp_shutdown(MCP_TURN_IDLE_SHUTDOWN_DELAY)
+        .await;
+    assert!(
+        !idle_mcp_shutdown_is_armed(&session),
+        "root threads keep their MCP fleet warm"
+    );
+    assert!(
+        !advance_past_idle_mcp_deadline(|| session.mcp_refresh.is_pending()).await,
+        "root threads must never have their MCP fleet torn down"
+    );
+
+    mark_session_as_subagent(&session).await;
+    session
+        .schedule_idle_mcp_shutdown(MCP_TURN_IDLE_SHUTDOWN_DELAY)
+        .await;
+    assert!(idle_mcp_shutdown_is_armed(&session));
+
+    session.abort_idle_mcp_shutdown();
+    assert!(!idle_mcp_shutdown_is_armed(&session));
+    assert!(
+        !advance_past_idle_mcp_deadline(|| session.mcp_refresh.is_pending()).await,
+        "an aborted teardown must not fire"
+    );
+}
