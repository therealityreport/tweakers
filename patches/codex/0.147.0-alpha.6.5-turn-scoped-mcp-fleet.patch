diff --git a/codex-rs/core/src/session/mcp_idle.rs b/codex-rs/core/src/session/mcp_idle.rs
new file mode 100644
index 0000000..1673287
--- /dev/null
+++ b/codex-rs/core/src/session/mcp_idle.rs
@@ -0,0 +1,357 @@
+//! Turn-idle MCP fleet retirement.
+//!
+//! Only explicit subagent sessions are eligible after a terminal turn. App-server
+//! roots use the explicit retirement entry point, which requires the exact
+//! subscriber count observed by app-server while mutating its subscription set.
+
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use super::*;
+
+pub(crate) const MCP_TURN_IDLE_SHUTDOWN_DELAY: Duration = Duration::from_secs(60);
+
+impl Session {
+    async fn idle_mcp_source_is_subagent(&self) -> bool {
+        matches!(
+            self.state.lock().await.session_configuration.session_source,
+            SessionSource::SubAgent(_)
+        )
+    }
+
+    async fn idle_mcp_source_is_app_server(&self) -> bool {
+        matches!(
+            self.state.lock().await.session_configuration.session_source,
+            SessionSource::Mcp
+        )
+    }
+
+    pub(crate) fn abort_idle_mcp_shutdown(&self) {
+        self.mcp_idle_generation.fetch_add(1, Ordering::AcqRel);
+        let handle = self
+            .mcp_idle_shutdown
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take();
+        if let Some(handle) = handle {
+            handle.abort();
+        }
+    }
+
+    pub(crate) async fn schedule_idle_mcp_shutdown(self: &Arc<Self>, delay: Duration) {
+        if !self.idle_mcp_source_is_subagent().await {
+            return;
+        }
+        self.schedule_idle_mcp_shutdown_inner(delay).await;
+    }
+
+    pub(crate) async fn schedule_app_server_mcp_retirement(
+        self: &Arc<Self>,
+        subscriber_count: usize,
+        seq: u64,
+    ) {
+        if !self.publish_app_server_mcp_subscribers(subscriber_count, seq) {
+            return;
+        }
+        if subscriber_count != 0 || !self.idle_mcp_source_is_app_server().await {
+            return;
+        }
+        self.schedule_idle_mcp_shutdown_inner(MCP_TURN_IDLE_SHUTDOWN_DELAY)
+            .await;
+    }
+
+    pub(crate) fn note_app_server_mcp_subscribers(&self, subscriber_count: usize, seq: u64) {
+        if !self.publish_app_server_mcp_subscribers(subscriber_count, seq) {
+            return;
+        }
+        if subscriber_count != 0 {
+            self.abort_idle_mcp_shutdown();
+        }
+    }
+
+    /// Applies one exact app-server subscriber publication, rejecting stale
+    /// sequences.
+    ///
+    /// Sequences are assigned inside app-server's `ThreadStateManager` lock, so
+    /// publications that arrive out of lock order after the lock is released
+    /// cannot clobber a newer count (a stale 0 must never arm retirement over a
+    /// live subscriber, and a stale positive count must never disarm it). An
+    /// equal sequence re-publishes the same mutation (`note` and `schedule`
+    /// share one mutation) and is accepted idempotently.
+    fn publish_app_server_mcp_subscribers(&self, subscriber_count: usize, seq: u64) -> bool {
+        let count = u64::try_from(subscriber_count).unwrap_or(u64::MAX);
+        let mut published = self
+            .app_server_mcp_subscribers
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if seq < published.0 {
+            return false;
+        }
+        *published = (seq, count);
+        true
+    }
+
+    fn app_server_mcp_subscriber_count(&self) -> u64 {
+        self.app_server_mcp_subscribers
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .1
+    }
+
+    async fn schedule_idle_mcp_shutdown_inner(self: &Arc<Self>, delay: Duration) {
+        self.abort_idle_mcp_shutdown();
+        let generation = self.mcp_idle_generation.load(Ordering::Acquire);
+        let weak = Arc::downgrade(self);
+        let handle = self
+            .services
+            .runtime_handle
+            .spawn(async move {
+                loop {
+                    tokio::time::sleep(delay).await;
+                    let Some(session) = weak.upgrade() else {
+                        return;
+                    };
+                    if session.mcp_idle_generation.load(Ordering::Acquire) != generation {
+                        return;
+                    }
+                    if session.shutdown_mcp_if_turn_idle(generation).await {
+                        return;
+                    }
+                }
+            })
+            .abort_handle();
+        let previous = self
+            .mcp_idle_shutdown
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .replace(handle);
+        if let Some(previous) = previous {
+            previous.abort();
+        }
+    }
+
+    async fn shutdown_mcp_if_turn_idle(&self, generation: u64) -> bool {
+        // Serialize retirement with runtime publication: while this permit is
+        // held, `refresh_mcp_if_dirty` (and the other publishers that share the
+        // gate) cannot reconcile against — and reuse clients from — a set this
+        // teardown is closing.
+        let Ok(_refresh) = self.mcp_refresh.acquire().await else {
+            // The gate closes only during session-runtime shutdown, which
+            // performs its own MCP teardown; stop retrying.
+            return true;
+        };
+        // Check every refusal gate only after the permit is held: a turn may
+        // have started or new input arrived while the acquire waited.
+        let is_app_server = self.idle_mcp_source_is_app_server().await;
+        if self.mcp_idle_generation.load(Ordering::Acquire) != generation
+            || self.active_turn.lock().await.is_some()
+            || self.input_queue.has_trigger_turn_mailbox_items().await
+            || self.input_queue.has_pending_input(&self.active_turn).await
+            || (is_app_server && self.app_server_mcp_subscriber_count() != 0)
+        {
+            return false;
+        }
+
+        // Invalidate BEFORE initiating teardown: the timer task can be aborted
+        // at any await inside `shutdown()` while the detached cleanup keeps
+        // closing clients, and a clean refresh flag would let the next turn
+        // reuse closed clients. All refusal gates passed above, so neither flag
+        // is ever set for a refused shutdown. `reconnect_on_next_refresh`
+        // guarantees the next publication builds fresh connections even if a
+        // refresh races the tail of the detached cleanup after an abort
+        // releases the permit. Marking dirty without scheduling a prewarm
+        // keeps the rebuild lazy: the next demand transparently rebuilds via
+        // `refresh_mcp_if_dirty`.
+        self.mark_mcp_runtime_dirty();
+        self.services.mcp_runtime.reconnect_on_next_refresh();
+        self.services.mcp_runtime.shutdown().await;
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::AgentPath;
+    use codex_protocol::ThreadId;
+    use codex_protocol::protocol::SessionSource;
+    use codex_protocol::protocol::SubAgentSource;
+    use std::sync::atomic::Ordering;
+
+    async fn make_subagent_session() -> Arc<Session> {
+        let (session, _turn_context, _events) =
+            crate::session::tests::make_session_and_context_with_rx().await;
+        session
+            .state
+            .lock()
+            .await
+            .session_configuration
+            .session_source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id: ThreadId::new(),
+            depth: 1,
+            agent_path: None,
+            agent_nickname: None,
+            agent_role: None,
+        });
+        session
+    }
+
+    async fn make_app_server_session() -> Arc<Session> {
+        let (session, _turn_context, _events) =
+            crate::session::tests::make_session_and_context_with_rx().await;
+        session
+            .state
+            .lock()
+            .await
+            .session_configuration
+            .session_source = SessionSource::Mcp;
+        session
+    }
+
+    /// The session fixtures mark the runtime dirty during construction, so
+    /// clear the pending refresh to make post-shutdown dirtiness observable.
+    fn reset_refresh_dirty(session: &Session) {
+        let _ = session.mcp_refresh.claim();
+    }
+
+    #[tokio::test]
+    async fn mcp_idle_subagent_root_busy_mailbox_retry_and_shutdown_transitions() {
+        let (root, _turn_context, _events) =
+            crate::session::tests::make_session_and_context_with_rx().await;
+        root.schedule_idle_mcp_shutdown(Duration::ZERO).await;
+        assert!(
+            root.mcp_idle_shutdown
+                .lock()
+                .expect("root idle lock")
+                .is_none()
+        );
+
+        let scheduled = make_subagent_session().await;
+        scheduled
+            .schedule_idle_mcp_shutdown(Duration::from_secs(3600))
+            .await;
+        let generation = scheduled.mcp_idle_generation.load(Ordering::Acquire);
+        assert!(
+            scheduled
+                .mcp_idle_shutdown
+                .lock()
+                .expect("subagent idle lock")
+                .is_some()
+        );
+        scheduled.abort_idle_mcp_shutdown();
+        assert!(scheduled.mcp_idle_generation.load(Ordering::Acquire) > generation);
+        assert!(
+            scheduled
+                .mcp_idle_shutdown
+                .lock()
+                .expect("aborted idle lock")
+                .is_none()
+        );
+
+        let busy = make_subagent_session().await;
+        reset_refresh_dirty(&busy);
+        *busy.active_turn.lock().await = Some(crate::state::ActiveTurn::default());
+        assert!(!busy.shutdown_mcp_if_turn_idle(0).await);
+        assert!(!busy.mcp_refresh.is_pending());
+
+        let mailbox = make_subagent_session().await;
+        reset_refresh_dirty(&mailbox);
+        mailbox
+            .input_queue
+            .enqueue_mailbox_communication(
+                InterAgentCommunication::new(
+                    AgentPath::root(),
+                    AgentPath::root(),
+                    Vec::new(),
+                    "keep MCP runtime for pending child work".to_string(),
+                    /*trigger_turn*/ true,
+                ),
+                /*parent_turn_id*/ None,
+            )
+            .await;
+        assert!(!mailbox.shutdown_mcp_if_turn_idle(0).await);
+        assert!(!mailbox.mcp_refresh.is_pending());
+
+        let terminal = make_subagent_session().await;
+        reset_refresh_dirty(&terminal);
+        assert!(terminal.shutdown_mcp_if_turn_idle(0).await);
+        assert!(terminal.mcp_refresh.is_pending());
+    }
+
+    #[tokio::test]
+    async fn mcp_idle_app_server_subscriber_gate_requires_final_unsubscribe() {
+        let session = make_app_server_session().await;
+        reset_refresh_dirty(&session);
+        session.note_app_server_mcp_subscribers(1, /*seq*/ 1);
+        let generation = session.mcp_idle_generation.load(Ordering::Acquire);
+        assert!(!session.shutdown_mcp_if_turn_idle(generation).await);
+        assert!(!session.mcp_refresh.is_pending());
+        session.note_app_server_mcp_subscribers(0, /*seq*/ 2);
+        assert!(session.shutdown_mcp_if_turn_idle(generation).await);
+        assert!(session.mcp_refresh.is_pending());
+    }
+
+    #[tokio::test]
+    async fn mcp_idle_app_server_stale_sequence_is_rejected() {
+        let session = make_app_server_session().await;
+        reset_refresh_dirty(&session);
+        session.note_app_server_mcp_subscribers(1, /*seq*/ 2);
+        let generation = session.mcp_idle_generation.load(Ordering::Acquire);
+
+        // A stale final-unsubscribe publication must neither clobber the newer
+        // count nor arm retirement.
+        session
+            .schedule_app_server_mcp_retirement(0, /*seq*/ 1)
+            .await;
+        assert!(
+            session
+                .mcp_idle_shutdown
+                .lock()
+                .expect("idle lock")
+                .is_none(),
+            "stale retirement publication must not arm the timer"
+        );
+        assert!(!session.shutdown_mcp_if_turn_idle(generation).await);
+        assert!(!session.mcp_refresh.is_pending());
+
+        // A stale note must not clobber the newer count either.
+        session.note_app_server_mcp_subscribers(0, /*seq*/ 1);
+        assert!(!session.shutdown_mcp_if_turn_idle(generation).await);
+        assert!(!session.mcp_refresh.is_pending());
+
+        // The genuinely newest final unsubscribe retires the fleet.
+        session
+            .schedule_app_server_mcp_retirement(0, /*seq*/ 3)
+            .await;
+        let generation = session.mcp_idle_generation.load(Ordering::Acquire);
+        assert!(session.shutdown_mcp_if_turn_idle(generation).await);
+        assert!(session.mcp_refresh.is_pending());
+    }
+
+    #[tokio::test]
+    async fn mcp_idle_shutdown_waits_for_refresh_gate() {
+        let session = make_subagent_session().await;
+        reset_refresh_dirty(&session);
+        let permit = session
+            .mcp_refresh
+            .acquire()
+            .await
+            .expect("refresh gate open");
+
+        let shutdown = session.shutdown_mcp_if_turn_idle(0);
+        tokio::pin!(shutdown);
+        assert!(
+            tokio::time::timeout(Duration::from_millis(100), &mut shutdown)
+                .await
+                .is_err(),
+            "retirement must wait for the refresh publication permit"
+        );
+
+        drop(permit);
+        let retired = tokio::time::timeout(Duration::from_secs(5), &mut shutdown)
+            .await
+            .expect("retirement must proceed once the permit is released");
+        assert!(retired);
+        assert!(session.mcp_refresh.is_pending());
+    }
+}
