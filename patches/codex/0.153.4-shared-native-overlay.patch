+        .await
+        .unwrap();
+    assert!(outcome.effective_plugins_changed);
+    assert!(native_manifest.exists());
+    assert!(!manager.store.is_installed(&plugin_id));
+    let overlay_config = std::fs::read_to_string(overlay.join("config.toml")).unwrap();
+    assert!(overlay_config.contains("enabled = false"));
+}
