+// Overlay cache ancestors cannot redirect a native writer into the base tree.
+pub(crate) fn ensure_unlinked_path(path: &Path) -> Result<(), PluginStoreError> {
+    for ancestor in path.ancestors() {
+        match fs::symlink_metadata(ancestor) {
+            Ok(metadata) if metadata.file_type().is_symlink() => {
+                return Err(PluginStoreError::Invalid(
+                    "shared plugin write path contains a symlink".to_string(),
+                ));
+            }
+            Ok(_) => {}
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(error) => {
+                return Err(PluginStoreError::io(
+                    "failed to inspect shared plugin write path",
+                    error,
+                ));
+            }
+        }
+    }
+    Ok(())
+}
