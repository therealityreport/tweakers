+            "enabled" | "unconfigured" => {
+                summary.local_version = Some("local".to_string());
+            }
+            "missing" | "removed" => {
+                summary.installed = false;
+                summary.enabled = false;
+            }
+            name => panic!("unexpected plugin {name}"),
