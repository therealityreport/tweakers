+                let plugin_id = PluginId::parse(&id).ok()?;
+                RemotePluginScope::from_marketplace_name(&plugin_id.marketplace_name)?;
+                let local_version = self.store.active_plugin_version(&plugin_id)?;
+                Some(SharedPluginInstallation {
