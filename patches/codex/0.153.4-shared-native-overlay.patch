+async fn shared_remote_uninstall_masks_local_package_without_provider_mutation() {
+    let fixture = TempDir::new().unwrap();
+    let root = std::fs::canonicalize(fixture.path()).unwrap();
+    let account = root.join("account");
+    let base = root.join("base");
+    let overlay = root.join("overlay");
+    for directory in [&account, &base, &overlay] {
+        std::fs::create_dir_all(directory).unwrap();
+    }
+    let roots = codex_config::TweakersSharedRoots {
+        native_base_root: codex_utils_absolute_path::AbsolutePathBuf::try_from(base.clone())
+            .unwrap(),
+        overlay_root: codex_utils_absolute_path::AbsolutePathBuf::try_from(overlay.clone())
+            .unwrap(),
+    };
+    let server = MockServer::start().await;
+    let mut config = load_plugins_config(&account, &account).await;
+    config.chatgpt_base_url = format!("{}/backend-api", server.uri());
+    let auth_manager = test_auth_manager(Some(AuthMode::Chatgpt));
+    let auth = auth_manager.auth().await;
+    let mut manager = test_plugins_manager_with_auth_manager(
+        account.clone(),
+        /*restriction_product*/ None,
+        auth_manager,
+    );
+    manager.store =
+        crate::store::PluginStore::try_new_with_shared_roots(account, Some(&roots)).unwrap();
+    manager.shared_roots = Some(roots);
+    let manager = Arc::new(manager);
+    let remote_id = "b1234567-89ab-4cde-8f01-234567890abc";
+    let plugin_id = PluginId::new(
+        "sample".to_string(),
+        REMOTE_GLOBAL_MARKETPLACE_NAME.to_string(),
+    )
+    .unwrap();
+    let native_manifest = base
+        .join("plugins/cache")
+        .join(REMOTE_GLOBAL_MARKETPLACE_NAME)
+        .join("sample/1.0.0/.codex-plugin/plugin.json");
+    write_file(&native_manifest, r#"{"name":"sample","version":"1.0.0"}"#);
+    Mock::given(method("GET")).and(path(format!("/backend-api/ps/plugins/{remote_id}")))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"id":remote_id,"name":"sample","scope":"GLOBAL","installation_policy":"AVAILABLE","authentication_policy":"ON_USE","release":{"display_name":"Sample","description":"Sample plugin","interface":{}}})))
+        .expect(1).mount(&server).await;
+    Mock::given(method("POST"))
+        .respond_with(ResponseTemplate::new(500))
+        .expect(0)
+        .mount(&server)
+        .await;
