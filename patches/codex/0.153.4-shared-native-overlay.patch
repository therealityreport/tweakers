+enabled = false
+[plugins."unconfigured@workspace-directory"]
+enabled = true
+"#,
+                    )
+                    .unwrap(),
+                ),
+                ConfigLayerEntry::new(
+                    ConfigLayerSource::SessionFlags,
+                    toml::from_str(
