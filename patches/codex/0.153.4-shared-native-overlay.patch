+fn shared_marketplace_admission_uses_base_and_overlay_without_trusting_other_roots() {
+    let tmp = TempDir::new().unwrap();
+    let root = fs::canonicalize(tmp.path()).unwrap();
+    let base = root.join("base");
+    let overlay = root.join("overlay");
+    let account = root.join("account");
+    for directory in [&base, &overlay, &account] {
+        fs::create_dir_all(directory).unwrap();
+    }
+    let shared = TweakersSharedRoots {
+        native_base_root: AbsolutePathBuf::try_from(base.clone()).unwrap(),
+        overlay_root: AbsolutePathBuf::try_from(overlay.clone()).unwrap(),
+    };
+    fs::create_dir_all(overlay.join("plugins")).unwrap();
+    fs::write(
+        overlay.join("plugins/tweakers-native-inventory.json"),
+        serde_json::json!({
+            "schema_version":1,"native_base_root":base,"plugins":[]
+        })
+        .to_string(),
+    )
+    .unwrap();
+    for (home, allowed) in [
+        (&base, true),
+        (&overlay, true),
+        (&root.join("unrelated"), false),
