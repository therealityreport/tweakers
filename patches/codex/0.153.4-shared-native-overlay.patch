+#[test]
+fn shared_bundled_marketplace_add_accepts_account_base_and_overlay_but_not_lookalikes() {
+    let tmp = TempDir::new().unwrap();
+    let root = fs::canonicalize(tmp.path()).unwrap();
+    let account = root.join("account");
+    let base = root.join("base");
+    let overlay = root.join("overlay");
+    for directory in [&account, &base, &overlay] {
+        fs::create_dir_all(directory).unwrap();
+    }
+    let shared = TweakersSharedRoots {
+        native_base_root: AbsolutePathBuf::try_from(base.clone()).unwrap(),
+        overlay_root: AbsolutePathBuf::try_from(overlay.clone()).unwrap(),
+    };
+    let restricted = config_layer_stack(
+        r#"
+[marketplaces]
+restrict_to_allowed_sources = true
+"#,
+    );
+    let bundled_under = |home: &Path| {
+        home.join(".tmp/bundled-marketplaces")
+            .join(crate::OPENAI_BUNDLED_MARKETPLACE_NAME)
+    };
+
+    for home in [&account, &base, &overlay] {
+        let bundled_root = bundled_under(home);
+        fs::create_dir_all(&bundled_root).unwrap();
+        let source = parse_source(
+            bundled_root.to_string_lossy().as_ref(),
+            /*ref_name*/ None,
+        );
+        let expected_name = validate_marketplace_source_for_add(
+            &account,
+            Some(&shared),
+            restricted.requirements(),
+            &source,
+        )
+        .expect("managed bundled source should be admitted");
+        assert_eq!(expected_name, Some(crate::OPENAI_BUNDLED_MARKETPLACE_NAME));
+        assert_eq!(
+            validate_marketplace_name_for_add(
+                expected_name,
+                crate::OPENAI_BUNDLED_MARKETPLACE_NAME
+            ),
+            Ok(())
+        );
+        assert!(validate_marketplace_name_for_add(expected_name, "other").is_err());
+    }
+
+    let base_source = parse_source(
+        bundled_under(&base).to_string_lossy().as_ref(),
+        /*ref_name*/ None,
+    );
+    assert_eq!(
+        validate_marketplace_source_for_add(
+            &account,
+            /*shared_roots*/ None,
+            &ConfigRequirements::default(),
+            &base_source,
+        ),
+        Ok(None),
+        "the native base is trusted only when shared roots are configured"
+    );
+
+    for lookalike in [
+        bundled_under(&root.join("unrelated")),
+        bundled_under(&root.join("base-lookalike")),
+        bundled_under(&base).join("nested"),
+        base.join(".tmp/other-marketplaces")
+            .join(crate::OPENAI_BUNDLED_MARKETPLACE_NAME),
+    ] {
+        fs::create_dir_all(&lookalike).unwrap();
+        let source = parse_source(lookalike.to_string_lossy().as_ref(), /*ref_name*/ None);
+        let expected_name = validate_marketplace_source_for_add(
+            &account,
+            Some(&shared),
+            &ConfigRequirements::default(),
+            &source,
+        )
+        .expect("unrestricted lookalike source should not fail source validation");
+        assert_eq!(expected_name, None, "{}", lookalike.display());
+        let err = validate_marketplace_name_for_add(
+            expected_name,
+            crate::OPENAI_BUNDLED_MARKETPLACE_NAME,
+        )
+        .expect_err("reserved name from a lookalike source should be rejected");
+        assert!(err.contains("is reserved and cannot be added"), "{err}");
+        assert!(
+            validate_marketplace_source_for_add(
+                &account,
+                Some(&shared),
+                restricted.requirements(),
+                &source,
+            )
+            .is_err(),
+            "{}",
+            lookalike.display()
+        );
+    }
+}
