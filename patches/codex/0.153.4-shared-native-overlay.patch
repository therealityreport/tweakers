+        assert!(!loaded.plugins()[0].has_enabled_skills);
+        assert_eq!(loaded.effective_mcp_servers().len(), 1);
+        assert!(manager.plugin_skill_snapshots_for_config(&config).is_none());
+    }
+    let source = root.join("source");
+    write_plugin(&source, "sample", "sample");
+    let id = PluginId::parse("sample@test").unwrap();
+    managers[0]
+        .store
+        .install(source.join("sample").abs(), id.clone())
+        .unwrap();
+    let loaded = managers[1].plugins_for_config(&config).await;
+    assert_eq!(
+        loaded.plugins()[0].root,
+        overlay.join("plugins/cache/test/sample/local").abs()
+    );
+    assert!(loaded.plugins()[0].has_enabled_skills);
+    assert!(loaded.effective_mcp_servers().is_empty());
+    managers[0].uninstall_plugin_id(id).await.unwrap();
+    assert!(
+        managers[1]
+            .plugins_for_config(&config)
+            .await
+            .capability_summaries()
+            .is_empty()
+    );
+    assert!(plugin_root.join(".codex-plugin/plugin.json").is_file());
+}
