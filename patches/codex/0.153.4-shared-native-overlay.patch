+fn active_version_in(root: &Path) -> Option<String> {
+    let mut versions = fs::read_dir(root)
+        .ok()?
+        .filter_map(Result::ok)
+        .filter_map(|entry| {
+            entry.file_type().ok().filter(std::fs::FileType::is_dir)?;
+            entry.file_name().into_string().ok()
+        })
+        .filter(|version| validate_plugin_version_segment(version).is_ok())
+        .collect::<Vec<_>>();
+    versions.sort_unstable_by(|left, right| compare_plugin_versions(left, right));
+    if versions
+        .iter()
+        .any(|version| version == DEFAULT_PLUGIN_VERSION)
+    {
+        Some(DEFAULT_PLUGIN_VERSION.to_string())
+    } else {
+        versions.pop()
+    }
+}
+
+// Overlay cache ancestors cannot redirect a native writer into the base tree.
+pub(crate) fn ensure_unlinked_path(path: &Path) -> Result<(), PluginStoreError> {
+    for ancestor in path.ancestors() {
+        match fs::symlink_metadata(ancestor) {
+            Ok(metadata) if metadata.file_type().is_symlink() => {
+                return Err(PluginStoreError::Invalid(
+                    "shared plugin write path contains a symlink".to_string(),
+                ));
+            }
+            Ok(_) => {}
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(error) => {
+                return Err(PluginStoreError::io(
+                    "failed to inspect shared plugin write path",
+                    error,
+                ));
+            }
+        }
+    }
+    Ok(())
+}
