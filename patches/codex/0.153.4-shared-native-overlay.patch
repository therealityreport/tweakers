+#[cfg(unix)]
+#[test]
+fn tweakers_shared_edits_write_overlay_and_reject_linked_config() {
+    let tmp = tempdir().expect("tmpdir");
+    let base = tmp.path().join("base");
+    let overlay = tmp.path().join("overlay");
+    std::fs::create_dir_all(&base).unwrap();
+    std::fs::create_dir_all(&overlay).unwrap();
+    let base = std::fs::canonicalize(base).unwrap();
+    let overlay = std::fs::canonicalize(overlay).unwrap();
+    let original = "model = \"base-model\"\n";
+    std::fs::write(base.join(CONFIG_TOML_FILE), original).unwrap();
+    let roots =
+        codex_config::TweakersSharedRoots::from_paths(Some(base.clone()), Some(overlay.clone()))
+            .unwrap()
+            .unwrap();
+    let mut builder = ConfigEditsBuilder::new(&overlay).set_model(Some("overlay-model"), None);
+    builder.shared_roots = Some(roots.clone());
+    builder.apply_blocking().unwrap();
+    assert!(
+        std::fs::read_to_string(overlay.join(CONFIG_TOML_FILE))
+            .unwrap()
+            .contains("overlay-model")
+    );
+    assert_eq!(
+        std::fs::read_to_string(base.join(CONFIG_TOML_FILE)).unwrap(),
+        original
+    );
+    std::fs::remove_file(overlay.join(CONFIG_TOML_FILE)).unwrap();
+    symlink(base.join(CONFIG_TOML_FILE), overlay.join(CONFIG_TOML_FILE)).unwrap();
+    let mut builder = ConfigEditsBuilder::new(&overlay).set_model(Some("unsafe"), None);
+    builder.shared_roots = Some(roots);
+    assert!(builder.apply_blocking().is_err());
+    assert_eq!(
+        std::fs::read_to_string(base.join(CONFIG_TOML_FILE)).unwrap(),
+        original
+    );
+}
