+#[tokio::test]
+async fn shared_plugin_uninstall_rejects_config_symlink_before_package_mutation() {
+    let tmp = TempDir::new().unwrap();
+    let root = fs::canonicalize(tmp.path()).unwrap();
+    let base = root.join("base");
+    let overlay = root.join("overlay");
+    fs::create_dir_all(&overlay).unwrap();
+    write_file(&base.join(CONFIG_TOML_FILE), "# native config\n");
+    std::os::unix::fs::symlink(base.join(CONFIG_TOML_FILE), overlay.join(CONFIG_TOML_FILE))
+        .unwrap();
+    let roots = TweakersSharedRoots {
+        native_base_root: base.clone().abs(),
+        overlay_root: overlay.clone().abs(),
+    };
+    let manager = PluginsManager::new_with_shared_roots(
+        root.join("account"),
+        test_auth_manager(/*auth_mode*/ None),
+        test_skill_root_loader(),
+        Some(&roots),
+    );
+    write_plugin(
+        &overlay.join("plugins/cache/test"),
+        "sample/local",
+        "sample",
+    );
+    let id = PluginId::parse("sample@test").unwrap();
+    assert!(manager.uninstall_plugin_id(id.clone()).await.is_err());
+    assert_eq!(
+        manager.store.active_plugin_root(&id),
