+    /// Present local shared installations without changing remote account state.
+    pub fn apply_shared_plugin_state(
+        &self,
+        config: &PluginsConfigInput,
+        summary: &mut crate::remote::RemotePluginSummary,
+    ) -> Result<(), PluginStoreError> {
+        self.apply_shared_plugin_states(config, std::iter::once(summary))
+    }
+
+    /// Project a response's plugin summaries using one policy-filtered config snapshot.
+    pub fn apply_shared_plugin_states<'a>(
+        &self,
+        config: &PluginsConfigInput,
+        summaries: impl IntoIterator<Item = &'a mut crate::remote::RemotePluginSummary>,
+    ) -> Result<(), PluginStoreError> {
+        if self.shared_roots.is_none() {
+            return Ok(());
+        }
+        let mut summaries = summaries.into_iter().peekable();
+        if summaries.peek().is_none() {
+            return Ok(());
+        }
+        // Config merging and policy filtering cover the entire stack. Do this once per response,
+        // rather than once for every plugin in a potentially large remote catalog.
+        let configured = configured_plugins_for_store(&config.config_layer_stack, &self.store)?;
+        for summary in summaries {
+            let Ok(plugin_id) = PluginId::parse(&summary.id) else {
+                continue;
+            };
+            summary.local_version = configured
+                .contains_key(&summary.id)
+                .then(|| self.store.active_plugin_version(&plugin_id))
+                .flatten();
+            summary.installed = summary.local_version.is_some();
+            summary.installed_at = None;
+            summary.enabled = summary.installed
+                && configured
+                    .get(&summary.id)
+                    .is_none_or(|plugin| plugin.enabled);
+        }
+        Ok(())
+    }
