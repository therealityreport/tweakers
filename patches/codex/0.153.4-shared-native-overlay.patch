+async fn shared_plugin_reads_observe_in_place_edits_and_other_account_mutations() {
+    let tmp = TempDir::new().unwrap();
+    let root = fs::canonicalize(tmp.path()).unwrap();
+    let base = root.join("base");
+    let overlay = root.join("overlay");
+    let roots = TweakersSharedRoots {
+        native_base_root: base.clone().abs(),
+        overlay_root: overlay.clone().abs(),
+    };
+    write_file(
+        &overlay.join("plugins/tweakers-native-inventory.json"),
+        &serde_json::json!({
+            "schema_version":1,"native_base_root":base,"plugins":[]
+        })
+        .to_string(),
+    );
+    let plugin_root = base.join("plugins/cache/test/sample/local");
+    write_plugin(&base.join("plugins/cache/test"), "sample/local", "sample");
+    let config = PluginsConfigInput::new(
+        ConfigLayerStack::new(
+            vec![ConfigLayerEntry::new(
+                ConfigLayerSource::User {
+                    file: base.join(CONFIG_TOML_FILE).abs(),
+                    profile: None,
+                },
+                toml::from_str(&plugin_config_toml(
+                    /*enabled*/ true, /*plugins_feature_enabled*/ true,
+                ))
+                .unwrap(),
+            )],
+            ConfigRequirements::default(),
+            ConfigRequirementsToml::default(),
+        )
+        .unwrap()
+        .with_tweakers_shared_roots(Some(roots.clone())),
+        String::new(),
+        /*plugins_enabled*/ true,
+        /*remote_plugin_enabled*/ false,
+        String::new(),
+        test_http_client_factory(),
+    );
+    let managers = ["account-a", "account-b"].map(|account| {
+        PluginsManager::new_with_shared_roots(
+            root.join(account),
+            test_auth_manager(/*auth_mode*/ None),
+            test_skill_root_loader(),
+            Some(&roots),
+        )
+    });
+    for manager in &managers {
+        assert!(manager.plugins_for_config(&config).await.plugins()[0].has_enabled_skills);
+    }
+    // Neither edit changes the package root directory's mtime.
+    write_file(
+        &plugin_root.join(".mcp.json"),
+        r#"{"mcpServers":{"sample":{"url":"https://sample.example/mcp"}}}"#,
+    );
+    fs::remove_file(plugin_root.join("skills/SKILL.md")).unwrap();
+    for manager in &managers {
