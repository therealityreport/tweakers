 const KEYRING_SERVICE: &str = "Codex MCP Credentials";
+
+/// MCP credentials belong to the Tweakers overlay, independently of the native
+/// history/account home. Reuse encrypted Secrets storage without migrating or
+/// deleting the native app's OAuth entries.
+fn tweakers_oauth_home() -> std::io::Result<Option<PathBuf>> {
+    let roots = codex_config::TweakersSharedRoots::from_paths(
+        std::env::var_os("TWEAKERS_NATIVE_BASE_ROOT").map(PathBuf::from),
+        std::env::var_os("TWEAKERS_OVERLAY_ROOT").map(PathBuf::from),
+    )?;
+    let Some(roots) = roots else {
+        return Ok(None);
+    };
+    let home = roots.overlay_root.join("mcp-oauth").to_path_buf();
+    let mut builder = std::fs::DirBuilder::new();
+    builder.recursive(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        builder.mode(0o700);
+    }
+    builder.create(&home)?;
+    let metadata = std::fs::symlink_metadata(&home)?;
+    if !metadata.is_dir()
+        || metadata.file_type().is_symlink()
+        || std::fs::canonicalize(&home)? != home
+    {
+        return Err(std::io::Error::other("unsafe Tweakers MCP credential root"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if metadata.permissions().mode() & 0o077 != 0 {
+            return Err(std::io::Error::other(
+                "Tweakers MCP credential root must be private",
+            ));
+        }
+    }
+    Ok(Some(home))
+}
+
+fn mcp_oauth_home() -> std::io::Result<PathBuf> {
+    match tweakers_oauth_home()? {
+        Some(home) => Ok(home),
+        None => find_codex_home().map(|home| home.to_path_buf()),
+    }
+}
+
+fn oauth_store_policy(
+    mode: OAuthCredentialsStoreMode,
+    backend: AuthKeyringBackendKind,
+) -> Result<(OAuthCredentialsStoreMode, AuthKeyringBackendKind)> {
+    if tweakers_oauth_home()?.is_some() {
+        // Never read native Direct entries or downgrade to plaintext on failure.
+        Ok((
+            OAuthCredentialsStoreMode::Keyring,
+            AuthKeyringBackendKind::Secrets,
+        ))
+    } else {
+        Ok((mode, backend))
+    }
+}
