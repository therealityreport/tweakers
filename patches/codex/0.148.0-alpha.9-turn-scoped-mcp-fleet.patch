+    let polled_alpha = Arc::new(AtomicBool::new(false));
+    let polled_beta = Arc::new(AtomicBool::new(false));
+    manager.insert_dormant_test_client("alpha", polled_flag_client(Arc::clone(&polled_alpha)));
+    manager.insert_dormant_test_client("beta", polled_flag_client(Arc::clone(&polled_beta)));
+
+    // Teardown must never first-poll a dormant startup future: the first poll
+    // is what could transiently spawn the stdio server process, exactly when
+    // the fleet is supposed to quiesce.
+    tokio::time::timeout(Duration::from_secs(10), manager.shutdown())
