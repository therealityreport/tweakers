+        "cancelled".to_string(),
+        server,
+        OAuthCredentialsStoreMode::default(),
+        AuthKeyringBackendKind::default(),
+        cancel_token,
+        /*tx_event*/ None,
+        ElicitationRequestManager::new(
+            approval_policy.value(),
+            PermissionProfile::default(),
+            /*reviewer*/ None,
+            /*lifecycle*/ None,
+            ElicitationRequestRouter::default(),
+        ),
+        /*codex_apps_tools_cache_context*/ None,
+        /*tool_catalog_cache_context*/ None,
+        runtime_context,
+        resolved_environment,
+        /*runtime_auth_provider*/ None,
+        ElicitationCapability::default(),
+        ClientMcpExtensions::default(),
+        crate::McpProtocolMode::Legacy,
+        crate::pagination::MAX_MCP_CATALOG_ITEMS,
+    );
+
+    // The first post-cancel poll must observe cancellation before any
+    // transport work (the or_cancel select is unbiased): a cancelled startup
+    // resolves Cancelled, never a transport-derived failure.
+    let outcome = tokio::time::timeout(Duration::from_secs(10), client.client())
+        .await
+        .expect("cancelled startup must resolve immediately");
+    match outcome {
+        Err(StartupOutcomeError::Cancelled) => {}
+        Err(error) => panic!(
+            "cancelled startup must resolve Cancelled without touching the transport, got {error:?}"
+        ),
+        Ok(_) => panic!("cancelled startup must not produce a client"),
+    }
+    assert!(
+        client.startup_complete.load(Ordering::Acquire),
+        "cancelled startup must still mark completion"
+    );
+}
