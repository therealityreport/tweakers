+    let store = PluginStore::try_new_with_shared_roots(account, Some(&roots)).unwrap();
+    let plugin_id = PluginId::parse("sample@debug").unwrap();
+    assert!(
+        store
+            .install(
+                AbsolutePathBuf::try_from(root.join("source")).unwrap(),
+                plugin_id.clone()
+            )
+            .is_err()
+    );
+    assert!(store.uninstall(&plugin_id).is_err());
+    assert!(
+        base.join("plugins/cache/debug/sample/1.0.0/.codex-plugin/plugin.json")
