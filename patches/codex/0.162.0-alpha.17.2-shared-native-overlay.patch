+}
+
+#[test]
+fn shared_native_inventory_rejects_missing_invalid_and_oversized_snapshots() {
+    let tmp = tempdir().unwrap();
+    let root = fs::canonicalize(tmp.path()).unwrap();
+    let base = root.join("base");
+    let overlay = root.join("overlay");
+    let roots = TweakersSharedRoots {
+        native_base_root: AbsolutePathBuf::try_from(base.clone()).unwrap(),
+        overlay_root: AbsolutePathBuf::try_from(overlay.clone()).unwrap(),
+    };
+    let store = PluginStore::try_new_with_shared_roots(root.join("account"), Some(&roots)).unwrap();
+    assert!(store.shared_native_inventory().is_err());
+    let path = overlay.join(NATIVE_INVENTORY_FILE);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    let valid = json!({"schema_version":1,"native_base_root":base,"plugins":[
+        {"id":"sample@openai-curated-remote","enabled":false,"version":"1.0.0"}
+    ]});
+    fs::write(&path, valid.to_string()).unwrap();
+    let entries = store.shared_native_inventory().unwrap().unwrap();
+    assert_eq!(
+        entries
+            .iter()
+            .map(|entry| (&entry.id, entry.enabled, &entry.version))
+            .collect::<Vec<_>>(),
+        vec![(
+            &"sample@openai-curated-remote".to_string(),
+            false,
+            &json!("1.0.0")
+        )]
+    );
+    let mut wrong_root = valid.clone();
+    wrong_root["native_base_root"] = json!(root.join("other"));
+    let mut duplicate = valid.clone();
+    duplicate["plugins"]
+        .as_array_mut()
+        .unwrap()
+        .push(valid["plugins"][0].clone());
+    let mut wrong_id = valid.clone();
+    wrong_id["plugins"][0]["id"] = json!("sample@untrusted");
+    let mut wrong_version = valid.clone();
+    wrong_version["plugins"][0]["version"] = json!(23);
+    let mut wrong_schema = valid.clone();
+    wrong_schema["schema_version"] = json!(2);
+    for invalid in [wrong_root, duplicate, wrong_id, wrong_version, wrong_schema] {
+        fs::write(&path, invalid.to_string()).unwrap();
+        assert!(store.shared_native_inventory().is_err());
+    }
+    fs::File::create(&path)
+        .unwrap()
+        .set_len(MAX_NATIVE_INVENTORY_BYTES + 1)
+        .unwrap();
+    assert!(store.shared_native_inventory().is_err());
+    #[cfg(unix)]
+    {
+        fs::remove_file(&path).unwrap();
+        let target = root.join("inventory.json");
+        fs::write(&target, valid.to_string()).unwrap();
+        std::os::unix::fs::symlink(&target, &path).unwrap();
+        assert!(store.shared_native_inventory().is_err());
+    }
+}
