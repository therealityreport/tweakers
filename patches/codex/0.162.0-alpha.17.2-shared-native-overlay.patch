+fn shared_installed_remote_marketplaces_to_info(
+    installations: Vec<codex_core_plugins::SharedPluginInstallation>,
+    remote_marketplaces: Vec<RemoteMarketplace>,
+) -> Vec<PluginMarketplaceEntry> {
+    let mut metadata = remote_marketplaces
+        .into_iter()
+        .flat_map(|marketplace| marketplace.plugins)
+        .map(|summary| (summary.id.clone(), summary))
+        .collect::<HashMap<_, _>>();
+    let mut marketplaces = std::collections::BTreeMap::<String, PluginMarketplaceEntry>::new();
+    for installation in installations {
+        let id = installation.plugin_id.as_key();
+        let mut summary = metadata
+            .remove(&id)
+            .map(remote_plugin_summary_to_info)
+            .unwrap_or_else(|| PluginSummary {
+                id,
+                remote_plugin_id: None,
+                version: None,
+                local_version: None,
+                name: installation.plugin_id.plugin_name.clone(),
+                share_context: None,
+                source: PluginSource::Remote,
+                installed: true,
+                installed_at: None,
+                enabled: installation.enabled,
+                install_policy: codex_app_server_protocol::PluginInstallPolicy::NotAvailable,
+                install_policy_source: None,
+                must_show_installation_interstitial: None,
+                auth_policy: codex_app_server_protocol::PluginAuthPolicy::OnUse,
+                availability: PluginAvailability::Available,
+                disabled_reason: None,
+                eligible_plan_types: None,
+                interface: None,
+                keywords: Vec::new(),
+            });
+        summary.installed = true;
+        summary.enabled = installation.enabled;
+        summary.local_version = Some(installation.local_version);
+        summary.installed_at = None;
+        let name = installation.plugin_id.marketplace_name;
+        marketplaces
+            .entry(name.clone())
+            .or_insert_with(|| PluginMarketplaceEntry {
+                name: name.clone(),
+                path: None,
+                interface: Some(MarketplaceInterface {
+                    display_name: Some(if name == REMOTE_GLOBAL_MARKETPLACE_NAME {
+                        "OpenAI Curated Remote".to_string()
+                    } else {
+                        name
+                    }),
+                }),
+                plugins: Vec::new(),
+            })
+            .plugins
+            .push(summary);
+    }
+    marketplaces.into_values().collect()
+}
