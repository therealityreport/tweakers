+/// Explicit shared configuration roots for a Tweakers app-server launch.
+/// History, authentication, and private runtime data retain their original home.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TweakersSharedRoots {
+    pub native_base_root: AbsolutePathBuf,
+    pub overlay_root: AbsolutePathBuf,
+}
+
+impl TweakersSharedRoots {
+    /// Validate the paired private launch settings without changing process state.
+    pub fn from_paths(
+        native_base_root: Option<PathBuf>,
+        overlay_root: Option<PathBuf>,
+    ) -> std::io::Result<Option<Self>> {
+        let invalid = || {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "Tweakers shared roots require two absolute, canonical, existing, disjoint directories",
+            )
+        };
+        let (base, overlay) = match (native_base_root, overlay_root) {
+            (None, None) => return Ok(None),
+            (Some(base), Some(overlay)) => (base, overlay),
+            _ => return Err(invalid()),
+        };
+        for path in [&base, &overlay] {
+            if !path.is_absolute() || !path.is_dir() || std::fs::canonicalize(path)? != *path {
+                return Err(invalid());
+            }
+        }
+        if base.starts_with(&overlay) || overlay.starts_with(&base) {
+            return Err(invalid());
+        }
+        Ok(Some(Self {
+            native_base_root: AbsolutePathBuf::from_absolute_path(base)?,
+            overlay_root: AbsolutePathBuf::from_absolute_path(overlay)?,
+        }))
+    }
+}
