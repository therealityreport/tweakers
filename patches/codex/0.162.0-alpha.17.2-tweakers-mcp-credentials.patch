+//! Explicit private-local authority for the isolated Tweakers MCP namespace.
+//! All descendants are opened relative to retained, unlinked directory descriptors.
+use std::fs::File;
+use std::io;
+use std::path::Path;
+
+#[cfg(unix)]
+mod unix {
+    use super::*;
+    use std::ffi::CString;
+    use std::io::Read;
+    use std::io::Write;
+    use std::os::fd::AsRawFd;
+    use std::os::fd::FromRawFd;
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::MetadataExt;
+    use std::path::Component;
+
+    pub struct PrivateLocalFile {
+        parent: File,
+        leaf: CString,
+    }
+    fn fail() -> io::Error {
+        io::Error::other("unsafe private local credential path")
+    }
+    fn owned(fd: i32) -> io::Result<File> {
+        if fd < 0 {
+            Err(io::Error::last_os_error())
+        } else {
+            Ok(unsafe { File::from_raw_fd(fd) })
+        }
+    }
+    fn name(value: &std::ffi::OsStr) -> io::Result<CString> {
+        CString::new(value.as_bytes()).map_err(|_| fail())
+    }
+    fn private_directory(file: &File) -> io::Result<()> {
+        let metadata = file.metadata()?;
+        if !metadata.is_dir()
+            || metadata.uid() != unsafe { libc::geteuid() }
+            || metadata.mode() & 0o077 != 0
+        {
+            return Err(fail());
+        }
+        Ok(())
+    }
+    impl PrivateLocalFile {
+        pub fn new(root: &Path, relative: &Path) -> io::Result<Self> {
+            if !root.is_absolute() || std::fs::canonicalize(root)? != root {
+                return Err(fail());
+            }
+            let mut parent = owned(unsafe {
+                libc::open(
+                    c"/".as_ptr(),
+                    libc::O_RDONLY | libc::O_DIRECTORY | libc::O_CLOEXEC,
+                )
+            })?;
+            for component in root.components() {
+                match component {
+                    Component::RootDir => (),
+                    Component::Normal(component) => {
+                        let component = name(component)?;
+                        parent = owned(unsafe {
+                            libc::openat(
+                                parent.as_raw_fd(),
+                                component.as_ptr(),
+                                libc::O_RDONLY
+                                    | libc::O_DIRECTORY
+                                    | libc::O_NOFOLLOW
+                                    | libc::O_CLOEXEC,
+                            )
+                        })?;
+                    }
+                    _ => return Err(fail()),
+                }
+            }
+            private_directory(&parent)?;
+            let mut components = relative.components().peekable();
+            let leaf;
+            loop {
+                let Some(Component::Normal(component)) = components.next() else {
+                    return Err(fail());
+                };
+                let component = name(component)?;
+                if components.peek().is_none() {
+                    leaf = component;
+                    break;
+                }
+                let created =
+                    unsafe { libc::mkdirat(parent.as_raw_fd(), component.as_ptr(), 0o700) };
+                if created < 0 && io::Error::last_os_error().kind() != io::ErrorKind::AlreadyExists
+                {
+                    return Err(io::Error::last_os_error());
+                }
+                parent = owned(unsafe {
+                    libc::openat(
+                        parent.as_raw_fd(),
+                        component.as_ptr(),
+                        libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+                    )
+                })?;
+                private_directory(&parent)?;
+            }
+            Ok(Self { parent, leaf })
+        }
+        fn open_leaf(&self, flags: i32) -> io::Result<File> {
+            private_directory(&self.parent)?;
+            let file = owned(unsafe {
+                libc::openat(
+                    self.parent.as_raw_fd(),
+                    self.leaf.as_ptr(),
+                    flags | libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC,
+                    0o600,
+                )
+            })?;
+            let metadata = file.metadata()?;
+            if !metadata.is_file()
+                || metadata.nlink() != 1
+                || metadata.uid() != unsafe { libc::geteuid() }
+                || metadata.mode() & 0o077 != 0
+            {
+                return Err(fail());
+            }
+            Ok(file)
+        }
+        pub fn read(&self) -> io::Result<Option<Vec<u8>>> {
+            let mut file = match self.open_leaf(libc::O_RDONLY) {
+                Ok(file) => file,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+                Err(error) => return Err(error),
+            };
+            let mut bytes = Vec::new();
+            file.read_to_end(&mut bytes)?;
+            Ok(Some(bytes))
+        }
+        pub fn open_lock(&self) -> io::Result<File> {
+            self.open_leaf(libc::O_RDWR | libc::O_CREAT)
+        }
+        pub fn write(&self, bytes: &[u8]) -> io::Result<()> {
+            // Reject the current leaf before any write; publish through this retained directory.
+            self.read()?;
+            let temporary = CString::new(format!(".mcp-private-{:032x}", rand::random::<u128>()))
+                .map_err(|_| fail())?;
+            let mut file = owned(unsafe {
+                libc::openat(
+                    self.parent.as_raw_fd(),
+                    temporary.as_ptr(),
+                    libc::O_WRONLY
+                        | libc::O_CREAT
+                        | libc::O_EXCL
+                        | libc::O_NOFOLLOW
+                        | libc::O_CLOEXEC,
+                    0o600,
+                )
+            })?;
+            let result = (|| {
+                file.write_all(bytes)?;
+                file.sync_all()?;
+                self.read()?;
+                if unsafe {
+                    libc::renameat(
+                        self.parent.as_raw_fd(),
+                        temporary.as_ptr(),
+                        self.parent.as_raw_fd(),
+                        self.leaf.as_ptr(),
+                    )
+                } < 0
+                {
+                    return Err(io::Error::last_os_error());
+                }
+                self.parent.sync_all()
+            })();
+            unsafe {
+                libc::unlinkat(self.parent.as_raw_fd(), temporary.as_ptr(), 0);
+            }
+            result
+        }
+        pub fn delete(&self) -> io::Result<()> {
+            let _file = match self.open_leaf(libc::O_RDONLY) {
+                Ok(file) => file,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
+                Err(error) => return Err(error),
+            };
+            if unsafe { libc::unlinkat(self.parent.as_raw_fd(), self.leaf.as_ptr(), 0) } < 0 {
+                return Err(io::Error::last_os_error());
+            }
+            self.parent.sync_all()
+        }
+    }
+}
+#[cfg(unix)]
+pub use unix::PrivateLocalFile;
+
+#[cfg(not(unix))]
+pub struct PrivateLocalFile;
+#[cfg(not(unix))]
+impl PrivateLocalFile {
+    pub fn new(_root: &Path, _relative: &Path) -> io::Result<Self> {
+        Err(io::Error::other(
+            "private MCP credential storage requires supported descriptor authority",
+        ))
+    }
+    pub fn read(&self) -> io::Result<Option<Vec<u8>>> {
+        unreachable!()
+    }
+    pub fn write(&self, _bytes: &[u8]) -> io::Result<()> {
+        unreachable!()
+    }
+    pub fn delete(&self) -> io::Result<()> {
+        unreachable!()
+    }
+    pub fn open_lock(&self) -> io::Result<File> {
+        unreachable!()
+    }
+}
