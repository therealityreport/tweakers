+// The generic cancellation select is unbiased. Check at this MCP boundary
+// before polling transport or cache-fetch work when shutdown already won.
+pub(crate) async fn run_mcp_startup_before_transport<T: Send>(
+    cancel_token: &CancellationToken,
+    startup: impl std::future::Future<Output = Result<T, StartupOutcomeError>> + Send,
+) -> Result<T, StartupOutcomeError> {
+    if cancel_token.is_cancelled() {
+        return Err(StartupOutcomeError::Cancelled);
+    }
+    match startup.or_cancel(cancel_token).await {
+        Ok(result) => result,
+        Err(CancelErr::Cancelled) => Err(StartupOutcomeError::Cancelled),
+    }
+}
