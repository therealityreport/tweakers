+/// MCP credentials belong to the Tweakers overlay, independently of the native
+/// history/account home. Reuse encrypted Secrets storage without migrating or
+/// deleting the native app's OAuth entries.
+fn tweakers_oauth_home() -> std::io::Result<Option<PathBuf>> {
+    let roots = codex_config::TweakersSharedRoots::from_paths(
+        std::env::var_os("TWEAKERS_NATIVE_BASE_ROOT").map(PathBuf::from),
+        std::env::var_os("TWEAKERS_OVERLAY_ROOT").map(PathBuf::from),
+    )?;
+    let Some(roots) = roots else {
+        return Ok(None);
+    };
+    Ok(Some(create_private_oauth_home(
+        roots.overlay_root.as_path(),
+    )?))
+}
+
+fn create_private_oauth_home(overlay: &std::path::Path) -> std::io::Result<PathBuf> {
+    // Retain the overlay descriptor before mkdir; never create through a re-resolved ancestor.
+    let _authority = codex_secrets::PrivateLocalFile::new(
+        overlay,
+        std::path::Path::new("mcp-oauth/.authority"),
+    )?;
+    let home = overlay.join("mcp-oauth");
+    let metadata = std::fs::symlink_metadata(&home)?;
+    if !metadata.is_dir()
+        || metadata.file_type().is_symlink()
+        || std::fs::canonicalize(&home)? != home
+    {
+        return Err(std::io::Error::other("unsafe Tweakers MCP credential root"));
+    }
+    Ok(home)
+}
+
+fn private_oauth_file(
+    relative: &std::path::Path,
+) -> std::io::Result<Option<codex_secrets::PrivateLocalFile>> {
+    tweakers_oauth_home()?
+        .map(|home| codex_secrets::PrivateLocalFile::new(&home, relative))
+        .transpose()
+}
+
+fn mcp_oauth_secrets_manager<K: KeyringStore + Clone + 'static>(
+    home: PathBuf,
+    store: &K,
+) -> Result<SecretsManager> {
+    Ok(if let Some(expected_home) = tweakers_oauth_home()? {
+        anyhow::ensure!(expected_home == home, "MCP credential root changed");
+        SecretsManager::new_with_private_local_namespace(
+            home,
+            Arc::new(store.clone()),
+            LocalSecretsNamespace::McpOAuth,
+        )
+    } else {
+        SecretsManager::new_with_keyring_store_and_namespace(
+            home,
+            SecretsBackendKind::Local,
+            Arc::new(store.clone()),
+            LocalSecretsNamespace::McpOAuth,
+        )
+    })
+}
+
+fn mcp_oauth_home() -> std::io::Result<PathBuf> {
+    match tweakers_oauth_home()? {
+        Some(home) => Ok(home),
+        None => find_codex_home().map(|home| home.to_path_buf()),
+    }
+}
+
+fn oauth_store_policy(
+    mode: OAuthCredentialsStoreMode,
+    backend: AuthKeyringBackendKind,
+) -> Result<(OAuthCredentialsStoreMode, AuthKeyringBackendKind)> {
+    if tweakers_oauth_home()?.is_some() {
+        // Retain the configured File/Keyring/Auto policy inside the isolated root.
+        // Native Direct entries are never read, migrated, or deleted.
+        Ok((mode, AuthKeyringBackendKind::Secrets))
+    } else {
+        Ok((mode, backend))
+    }
+}
