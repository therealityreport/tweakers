+#[tokio::test]
+async fn pre_cancelled_startup_does_not_enter_transport() {
+    // Count actual polls at the production startup boundary. An immediately
+    // ready transport makes both arms ready in the upstream unbiased select.
+    let polls = AtomicUsize::new(0);
+    let cancelled = CancellationToken::new();
+    cancelled.cancel();
+    for _ in 0..64 {
+        let result = crate::rmcp_client::run_mcp_startup_before_transport(&cancelled, async {
+            polls.fetch_add(1, Ordering::SeqCst);
+            Ok::<_, StartupOutcomeError>(())
+        })
+        .await;
+        assert_matches!(result, Err(StartupOutcomeError::Cancelled));
+    }
+    assert_eq!(polls.load(Ordering::SeqCst), 0);
+    crate::rmcp_client::run_mcp_startup_before_transport(&CancellationToken::new(), async {
+        polls.fetch_add(1, Ordering::SeqCst);
+        Ok::<_, StartupOutcomeError>(())
+    })
+    .await
+    .expect("uncancelled startup enters transport");
+    assert_eq!(polls.load(Ordering::SeqCst), 1);
+}
