{
  "name": "@therealityreport/tweakers",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "description": "Tweak system for the OpenAI Codex desktop app",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/therealityreport/tweakers.git"
  },
  "bugs": {
    "url": "https://github.com/therealityreport/tweakers/issues"
  },
  "homepage": "https://github.com/therealityreport/tweakers#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/local-work.mjs build",
    "deps:install": "node scripts/local-work.mjs dependencies",
    "build:manager-launcher:release": "node packages/native-host/scripts/build.mjs --release-manager-launcher",
    "browser": "tsx packages/installer/src/cli.ts browser",
    "lint": "eslint packages/*/src tweaks scripts --ext .ts,.js,.mjs,.cjs --no-error-on-unmatched-pattern",
    "check:tweak-catalog": "node scripts/check-tweak-catalog.mjs store/index.json",
    "sync:tweaks": "node scripts/local-work.mjs sync",
    "check:public-history": "scripts/check-public-history.sh",
    "clean": "node scripts/local-work.mjs clean",
    "test": "node scripts/local-work.mjs test",
    "test:user-questions": "node --import ./scripts/test-root-preload.mjs scripts/test-tweaks.mjs --tweak user-questions",
    "test:tweaks": "node --import ./scripts/test-root-preload.mjs scripts/test-tweaks.mjs",
    "typecheck": "node scripts/local-work.mjs typecheck",
    "audit": "npm audit --workspaces --include-workspace-root",
    "dev:codex": "npm exec --package=@openai/codex@0.153.4 -- codex",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "tsx": "^4.23.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "tweaker": "bin/tweaker.js",
    "tweakers": "bin/tweaker.js",
    "codexplusplus": "bin/tweaker.js",
    "codex-plusplus": "bin/tweaker.js"
  },
  "dependencies": {
    "@electron/asar": "^3.4.0",
    "kleur": "^4.1.5",
    "plist": "^3.1.0",
    "prompts": "^2.4.2",
    "sade": "^1.8.1",
    "tar": "^7.5.22"
  }
}
